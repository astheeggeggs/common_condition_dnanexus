{
  "name": "iterative-conditioning-regenie",
  "title": "iterative-conditioning-regenie",
  "summary": "pipeline to run iterative conditioning at the variant level for gene-trait pairs using regenie",
  "dxapi": "1.0.0",
  "inputSpec": [
    {
      "name": "KEEP",
      "help": "",
      "class": "file",
      "patterns": ["*"],
      "optional": false
    },

    {
      "name": "PHENOTYPES",
      "help": "",
      "class": "file",
      "patterns": ["*"],
      "optional": false
    },

    {
      "name": "COVARIATES",
      "help": "",
      "class": "file",
      "patterns": ["*"],
      "optional": false
    },
    {
      "name": "LOCO_DIR",
      "help": "",
      "class": "array:file",
      "patterns": ["*.loco"],
      "optional": false
    },
    {
      "name": "ANNOTATION_DIR",
      "help": "",
      "class": "array:file",
      "patterns": ["*.txt"],
      "optional": false
    },
    {
      "name": "RUN_DIR",
      "help": "",
      "class": "array:file",
      "patterns": ["*"],
      "optional": true
    },
    {
      "name": "REGENIE_DIR",
      "help": "",
      "class": "array:file",
      "patterns": ["*"],
      "optional": true
    },
    {
      "name": "PLINK_BIM",
      "help": "",
      "class": "file",
      "patterns": ["*.bim"],
      "optional": false
    },
    {
      "name": "PLINK_BED",
      "help": "",
      "class": "file",
      "patterns": ["*.bed"],
      "optional": false
    },
    {
      "name": "PLINK_FAM",
      "help": "",
      "class": "file",
      "patterns": ["*.fam"],
      "optional": false
    },
    {
      "name": "GENE_TRAIT_PAIRS_TO_TEST",
      "help": "",
      "class": "file",
      "patterns": ["*.csv"],
      "optional": false
    },
    {
      "name": "ANC",
      "help": "",
      "class": "string",
      "optional": false
    },
    {
      "name": "CHR",
      "help": "",
      "class": "string",
      "optional": false
    },
    {
      "name": "P_T",
      "help": "",
      "class": "float",
      "optional": false
    }
  ],
  "outputSpec": [
    {
      "name": "run_files",
      "help": "",
      "class": "array:file",
      "patterns": ["*"]
    },
    {
      "name": "regenie_outputs",
      "help": "",
      "class": "array:file",
      "patterns": ["*"]
    },
    {
      "name": "combined_outputs",
      "help": "",
      "class": "array:file",
      "patterns": ["*"]
    }
  ],
  "runSpec": {
    "interpreter": "bash",
    "executionPolicy": {
      "restartOn": {
        "*": 0
      }
    },
    "timeoutPolicy": {
      "*": {
        "hours": 72
      }
    },
    "headJobOnDemand": false,
    "inheritParentRestartOnPolicy": false,
    "distribution": "Ubuntu",
    "release": "24.04",
    "version": "0",
    "file": "src/code.sh"
  },
  "access": {
    "network": [
      "*"
    ]
  },
  "ignoreReuse": false,
  "regionalOptions": {
    "aws:eu-west-2": {
      "systemRequirements": {
        "*": {
          "instanceType": "mem1_ssd1_v2_x8"
        }
      }
    }
  }
}
