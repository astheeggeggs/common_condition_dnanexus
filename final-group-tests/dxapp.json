{
  "name": "final-group-tests",
  "title": "final-group-tests",
  "summary": "pipeline to take a collection (genes, trait, max_MAF) tuples together with conditioning varaints for final group tests.",
  "dxapi": "1.0.0",
  "inputSpec": [
    {
      "name": "MODEL_DIR",
      "help": "",
      "class": "array:file",
      "patterns": ["*.rda"],
      "optional": false
    },
    {
      "name": "SPARSE_MATRIX",
      "help": "",
      "class": "file",
      "patterns": ["*"],
      "optional": false
    },
    {
      "name": "SPARSE_MATRIX_IDs",
      "help": "",
      "class": "file",
      "patterns": ["*"],
      "optional": false
    },
    {
      "name": "VARIANCE_DIR",
      "help": "",
      "class": "array:file",
      "patterns": ["*.txt"],
      "optional": false
    },
    {
      "name": "GROUP_DIR",
      "help": "",
      "class": "array:file",
      "patterns": ["*.txt.gz"],
      "optional": false
    },
    {
      "name": "RUN_DIR",
      "help": "",
      "class": "array:file",
      "patterns": ["*"],
      "optional": true
    },
    {
      "name": "SAIGE_DIR",
      "help": "",
      "class": "array:file",
      "patterns": ["*"],
      "optional": true
    },
    {
      "name": "VCF",
      "help": "",
      "class": "file",
      "patterns": ["*vcf.bgz"],
      "optional": true
    },
    {
      "name": "VCF_CSI",
      "help": "",
      "class": "file",
      "patterns": ["*.vcf.bgz.csi"],
      "optional": true
    },
    {
      "name": "PLINK_BIM",
      "help": "",
      "class": "file",
      "patterns": ["*.bim"],
      "optional": true
    },
    {
      "name": "PLINK_BED",
      "help": "",
      "class": "file",
      "patterns": ["*.bed"],
      "optional": true
    },
    {
      "name": "PLINK_FAM",
      "help": "",
      "class": "file",
      "patterns": ["*.fam"],
      "optional": true
    },
    {
      "name": "GENE_TRAIT_PAIRS_TO_TEST",
      "help": "",
      "class": "file",
      "patterns": ["*.tsv.gz"],
      "optional": false
    },
    {
      "name": "ANC",
      "help": "",
      "class": "string",
      "optional": false
    },
    {
      "name": "CHR",
      "help": "",
      "class": "string",
      "optional": false
    }
  ],
  "outputSpec": [
    {
      "name": "final_run_files",
      "help": "",
      "class": "array:file",
      "patterns": ["*"]
    },
    {
      "name": "final_saige_outputs",
      "help": "",
      "class": "array:file",
      "patterns": ["*"]
    },
    {
      "name": "final_combined_outputs",
      "help": "",
      "class": "array:file",
      "patterns": ["*"]
    }
  ],
  "runSpec": {
    "interpreter": "bash",
    "executionPolicy": {
      "restartOn": {
        "*": 0
      }
    },
    "timeoutPolicy": {
      "*": {
        "hours": 72
      }
    },
    "headJobOnDemand": false,
    "inheritParentRestartOnPolicy": false,
    "distribution": "Ubuntu",
    "release": "24.04",
    "version": "0",
    "file": "src/code.sh"
  },
  "access": {
    "network": [
      "*"
    ]
  },
  "ignoreReuse": false,
  "regionalOptions": {
    "aws:eu-west-2": {
      "systemRequirements": {
        "*": {
          "instanceType": "mem1_ssd1_v2_x8"
        }
      }
    }
  }
}
